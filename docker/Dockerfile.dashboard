# Dashboard Streamlit de monitoramento. Build a partir da raiz do repositório:
#   docker build -f docker/Dockerfile.dashboard -t churn-dashboard .
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

COPY dashboard ./dashboard
# os logs da simulação são montados como volume em /app/reports (ver docker-compose.yml)

EXPOSE 8501
CMD ["streamlit", "run", "dashboard/app.py", "--server.port", "8501", "--server.address", "0.0.0.0", "--server.headless", "true"]
